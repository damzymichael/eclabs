---
import Layout from "../../../layouts/Layout.astro"
import { BsFillInfoCircleFill } from "react-icons/bs"
import {
  FaCheckCircle,
  FaGraduationCap,
  FaBriefcase,
  FaUserFriends,
  FaVenusMars,
} from "react-icons/fa"
import { FaScaleBalanced, FaBacteria, FaVirus } from "react-icons/fa6"
---

<Layout>
  <div class="w-full font-sans text-gray-800 bg-white">
    {/* Breadcrumbs */}
    <nav class="bg-gray-50 py-4 px-6 md:px-12 lg:px-24 border-b border-gray-200">
      <ol class="flex items-center space-x-2 text-sm text-gray-500">
        <li>
          <a href="/" class="hover:underline hover:text-[#01329C] transition-colors"> Home </a>
        </li>
        <li>»</li>
        <li>
          <a href="/services" class="hover:underline hover:text-[#01329C] transition-colors"
            >Services</a
          >
        </li>
        <li>»</li>
        <li class="text-gray-700 font-medium">Drug & STI Testing</li>
      </ol>
    </nav>

    {/* Hero Section */}
    <section
      class="relative py-20 md:py-28 px-6 text-center border-b border-gray-100 overflow-hidden bg-cover bg-center"
      style="background-image: url('/about-us-background.jpg')"
    >
      <div class="absolute inset-0 bg-white/50 pointer-events-none"></div>
      <div class="relative z-10 max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#01329C] mb-6 tracking-tight">
          Drug & STI Testing
        </h1>
        <p class="text-lg md:text-xl text-gray-700 font-medium">
          Reliable screening for sexually transmitted infections and comprehensive drug testing
          services for workplaces, schools, and personal peace of mind.
        </p>
      </div>
    </section>

    {/* Important Notice Bar */}
    <div class="bg-gray-100 py-6 px-6 md:px-12 lg:px-24 border-b border-gray-200">
      <div class="flex items-center gap-3 text-gray-700">
        <div class="shrink-0 text-red-600">
          <BsFillInfoCircleFill size={20} />
        </div>
        <p class="text-lg leading-relaxed">
          <span class="text-red-600 font-bold uppercase">IMPORTANT</span>
          {" — "}
          <a
            download
            href="/ec_labs_full_test_menu.pdf"
            class="text-[#01329C] font-semibold hover:underline"
          >
            Click here
          </a>{" "}
          to download full list of laboratory tests
        </p>
      </div>
    </div>

    {/* Main Content Section */}
    <section class="py-16 px-6 md:px-12 lg:px-24 max-w-7xl mx-auto">
      {/* Services Grid */}
      <div class="mb-20">
        <h2 class="text-3xl font-bold text-center text-[#01329C] mb-12">Our Testing Services</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
          <div
            class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center justify-center text-center shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 group"
          >
            <div
              class="mb-5 bg-white p-4 rounded-full shadow-md text-[#43158c] group-hover:scale-110 transition-transform duration-300"
            >
              <FaGraduationCap size={40} />
            </div>
            <h3 class="font-bold text-xl text-gray-800">Schools</h3>
          </div>
          <div
            class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center justify-center text-center shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 group"
          >
            <div
              class="mb-5 bg-white p-4 rounded-full shadow-md text-[#43158c] group-hover:scale-110 transition-transform duration-300"
            >
              <FaBriefcase size={40} />
            </div>
            <h3 class="font-bold text-xl text-gray-800">Workplace</h3>
          </div>
          <div
            class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center justify-center text-center shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 group"
          >
            <div
              class="mb-5 bg-white p-4 rounded-full shadow-md text-[#43158c] group-hover:scale-110 transition-transform duration-300"
            >
              <FaScaleBalanced size={40} />
            </div>
            <h3 class="font-bold text-xl text-gray-800">Legal</h3>
          </div>
          <div
            class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center justify-center text-center shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 group"
          >
            <div
              class="mb-5 bg-white p-4 rounded-full shadow-md text-[#43158c] group-hover:scale-110 transition-transform duration-300"
            >
              <FaUserFriends size={40} />
            </div>
            <h3 class="font-bold text-xl text-gray-800">Family Peace of Mind</h3>
          </div>
          <div
            class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center justify-center text-center shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 group"
          >
            <div
              class="mb-5 bg-white p-4 rounded-full shadow-md text-[#01329C] group-hover:scale-110 transition-transform duration-300"
            >
              <FaVenusMars size={40} />
            </div>
            <h3 class="font-bold text-xl text-gray-800">STI Screening</h3>
          </div>
          <div
            class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center justify-center text-center shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 group"
          >
            <div
              class="mb-5 bg-white p-4 rounded-full shadow-md text-[#01329C] group-hover:scale-110 transition-transform duration-300"
            >
              <FaBacteria size={40} />
            </div>
            <h3 class="font-bold text-xl text-gray-800">Infectious Diseases</h3>
          </div>
          <div
            class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center justify-center text-center shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 group"
          >
            <div
              class="mb-5 bg-white p-4 rounded-full shadow-md text-[#01329C] group-hover:scale-110 transition-transform duration-300"
            >
              <FaVirus size={40} />
            </div>
            <h3 class="font-bold text-xl text-gray-800">HBV & HCV Viral Load</h3>
          </div>
        </div>
      </div>

      {/* Category 1 */}
      <div class="flex flex-col md:flex-row items-center gap-10 mb-20">
        <div class="w-full md:w-1/2">
          <img
            src="/sample.png"
            alt="STI Testing"
            class="rounded-2xl shadow-lg w-full h-125 object-cover max-h-96"
          />
        </div>
        <div class="w-full md:w-1/2">
          <h2 class="text-3xl font-bold text-[#01329C] mb-6">
            Sexually Transmitted Infections (STI)
          </h2>
          <p class="text-gray-600 text-lg mb-6 leading-relaxed">
            Protect your health and the health of your partner. We offer highly accurate,
            confidential, and comprehensive screening panels for a wide range of sexually
            transmitted infections.
          </p>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <li class="flex items-start gap-3">
              <FaCheckCircle className="text-[#106c27] mt-1 shrink-0" size={20} />
              <span class="text-gray-700 text-lg">HIV Testing</span>
            </li>
            <li class="flex items-start gap-3">
              <FaCheckCircle className="text-[#106c27] mt-1 shrink-0" size={20} />
              <span class="text-gray-700 text-lg">Hepatitis B (surface Ag)</span>
            </li>
            <li class="flex items-start gap-3">
              <FaCheckCircle className="text-[#106c27] mt-1 shrink-0" size={20} />
              <span class="text-gray-700 text-lg">Hepatitis C virus</span>
            </li>
            <li class="flex items-start gap-3">
              <FaCheckCircle className="text-[#106c27] mt-1 shrink-0" size={20} />
              <span class="text-gray-700 text-lg">Syphilis</span>
            </li>
            <li class="flex items-start gap-3">
              <FaCheckCircle className="text-[#106c27] mt-1 shrink-0" size={20} />
              <span class="text-gray-700 text-lg">Chlamydia</span>
            </li>
            <li class="flex items-start gap-3">
              <FaCheckCircle className="text-[#106c27] mt-1 shrink-0" size={20} />
              <span class="text-gray-700 text-lg">Herpes simplex 1 & 2</span>
            </li>
          </ul>
          <div class="mt-8 flex gap-3 flex-col sm:flex-row">
            <a
              href="/book-appointment"
              class="inline-block bg-[#01329C] text-white font-semibold py-3 px-8 text-center rounded-3xl hover:bg-[#01226b] transition-colors shadow-md hover:shadow-lg"
            >
              Book Appointment
            </a>

            <a
              href="/ec_labs_full_test_menu.pdf"
              class="inline-block text-center bg-[#9B0100] px-5 py-3 rounded-full font-semibold text-white border border-red-500 hover:bg-[#7a0100] transition-colors"
            >
              Download full test menu
            </a>
          </div>
        </div>
      </div>

      {/* Category 2 */}
      <div class="flex flex-col md:flex-row-reverse items-center gap-10 mb-10">
        <div class="w-full md:w-1/2">
          <img
            src="/microscope-lab.png"
            alt="Drug Testing Services"
            class="rounded-2xl shadow-lg w-full h-auto object-cover max-h-96"
          />
        </div>
        <div class="w-full md:w-1/2">
          <h2 class="text-3xl font-bold text-[#01329C] mb-6">Drug Testing Services</h2>
          <p class="text-gray-600 text-lg mb-6 leading-relaxed">
            In addition to infectious disease screening, we provide rigorous drug testing solutions
            to ensure safety and compliance across multiple environments.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <FaCheckCircle className="text-[#106c27] mt-1 shrink-0" size={20} />
              <span class="text-gray-700 text-lg"
                ><strong>Workplace & Schools:</strong> Routine or unannounced screening for compliance
                and safety.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <FaCheckCircle className="text-[#106c27] mt-1 shrink-0" size={20} />
              <span class="text-gray-700 text-lg"
                ><strong>Legal & Forensic:</strong> Certified testing protocols supporting legal documentation
                and proceedings.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <FaCheckCircle className="text-[#106c27] mt-1 shrink-0" size={20} />
              <span class="text-gray-700 text-lg"
                ><strong>Family Peace of Mind:</strong> Private testing services managed with complete
                confidentiality and care.</span
              >
            </li>
          </ul>
          <div class="mt-8 flex gap-3 flex-col sm:flex-row">
            <a
              href="/book-appointment"
              class="inline-block bg-[#01329C] text-white font-semibold py-3 px-8 text-center rounded-3xl hover:bg-[#01226b] transition-colors shadow-md hover:shadow-lg"
            >
              Book Appointment
            </a>

            <a
              href="/ec_labs_full_test_menu.pdf"
              class="inline-block text-center bg-[#9B0100] px-5 py-3 rounded-full font-semibold text-white border border-red-500 hover:bg-[#7a0100] transition-colors"
            >
              Download full test menu
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
