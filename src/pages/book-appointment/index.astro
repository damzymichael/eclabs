---
import Layout from "../../layouts/Layout.astro"
import { BsFillInfoCircleFill } from "react-icons/bs"
import AppointmentForm from "../../components/AppointmentForm"
---

<Layout>
  <div class="w-full font-sans">
    {/* 1. Breadcrumbs */}
    <nav class="bg-gray-50 py-3 px-6 md:px-12 lg:px-24">
      <ol class="flex items-center space-x-2 text-sm text-gray-400">
        <li>
          <a href="/" class="hover:underline text-gray-500"> Home </a>
        </li>
        <li>»</li>
        <li>Request Quote</li>
      </ol>
    </nav>

    {/* 2. Hero Banner */}
    <section class="bg-[#01329C] text-white py-12 px-6 md:px-12 lg:px-24">
      <div class="max-w-6xl">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">Quotation Request</h1>
        <p class="text-lg opacity-90">
          If you need assistance completing this form please call{" "}
          <a href="tel:+2349033596255" class="font-semibold">0903 359 6255</a>
        </p>
      </div>
    </section>

    {/* 3. Important Notice Bar */}
    <div class="bg-gray-100 py-6 px-6 md:px-12 lg:px-24 border-b border-gray-200">
      <div class="flex items-center gap-3 text-gray-700">
        <div class="shrink-0 text-red-600">
          <BsFillInfoCircleFill size={20} />
        </div>
        <p class="text-lg leading-relaxed">
          <span class="text-red-600 font-bold uppercase">IMPORTANT</span>
          {" — "}
          <a
            download
            href="/ec_labs_full_test_menu.pdf"
            class="text-[#01329C] font-semibold hover:underline"
          >
            Click here
          </a>{" "}
          to download full list of laboratory tests
        </p>
      </div>
    </div>

    {/* 4. Appointment Form */}
    <div class="bg-gray-50 pb-16">
      <AppointmentForm client:load />
    </div>
  </div>
</Layout>
